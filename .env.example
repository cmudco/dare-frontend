# Environment: development, production, staging, etc.
VITE_APP_ENVIRONMENT=development

# Django Backend URL
VITE_DJANGO_BACKEND_URL=http://localhost:8000

# WebSocket URL
VITE_WEBSOCKET_URL=ws://localhost:8000

# Sentry DSN
VITE_SENTRY_DSN=

# Research Tools, for the "Go to Research Tools" handover. Leave blank to hide it.
VITE_RESEARCH_TOOLS_URL=http://localhost:3000
